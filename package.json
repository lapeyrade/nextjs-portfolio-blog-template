{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun format && bun fix && bun run --bun next dev",
    "build": "bun run typecheck && bun run --bun next build",
    "typecheck": "bun run --bun next typegen && bun check",
    "check:all": "bun run format && bun run fix && bun run build",
    "start": "bun run --bun next start",
    "lint": "oxlint",
    "test": "bun run typecheck && bun test tests scripts/qa/runtime-policy.test.mjs",
    "fix": "oxlint --fix --fix-suggestions",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^14.7.1",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "resend": "^6.35.0",
    "shiki": "^4.5.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
